PREFIX core: <https://ontology.unifiedcyberontology.org/uco/core/>
PREFIX observable: <https://ontology.unifiedcyberontology.org/uco/observable/>
PREFIX ioi-ext: <https://ioi-framework.github.io/ns/ioi-ext/>

SELECT ?domain ?evidence_files ?mft_examples ?usn_events ?usn_evidence
WHERE {
  {
    SELECT ?domain
           (COUNT(DISTINCT ?mft_file) AS ?evidence_files)
           (GROUP_CONCAT(DISTINCT ?mft_file; separator=" ; ") AS ?mft_examples)
    WHERE {
      {
        SELECT DISTINCT ?domain ?mft_file
        WHERE {
          GRAPH <http://example.org/mft_case2> {
            { ?facet ioi-ext:parentPath ?path . FILTER(CONTAINS(?path, "IndexedDB")) }
            UNION
            { ?facet observable:filePath ?path . FILTER(CONTAINS(?path, "IndexedDB")) }
            BIND(STRBEFORE(STRAFTER(?path, "https_www."), "_") AS ?domain)
            FILTER(?domain != "")
            BIND(?path AS ?mft_file)
          }
        }
      }
      OPTIONAL {
        {
          SELECT DISTINCT ?histDomain
          WHERE {
            GRAPH <http://example.org/history_case2> {
              ?url_facet observable:fullValue ?url_value .
              BIND(STRAFTER(STR(?url_value), "://") AS ?after_scheme)
              BIND(IF(STRSTARTS(?after_scheme, "www."), STRAFTER(?after_scheme, "www."), ?after_scheme) AS ?host_and_path)
              BIND(STRBEFORE(CONCAT(?host_and_path, "/"), "/") AS ?histDomain)
            }
          }
        }
        FILTER(?histDomain = ?domain)
      }
      FILTER(!BOUND(?histDomain))
    }
    GROUP BY ?domain
  }

  {
    SELECT (COUNT(DISTINCT ?usn_file) AS ?usn_events)
           (GROUP_CONCAT(DISTINCT ?update_reasons; separator=" ; ") AS ?usn_evidence)
    WHERE {
      GRAPH <http://example.org/usn_case2> {
        ?usn_file a observable:File ;
                  core:hasFacet ?usn_file_facet, ?usn_facet .
        ?usn_file_facet a observable:FileFacet ;
                        observable:fileName ?usn_filename .
        ?usn_facet a ioi-ext:UsnFacet ;
                   ioi-ext:updateReasons ?update_reasons .
        FILTER(?usn_filename = "History")
        FILTER(
          CONTAINS(?update_reasons, "DataTruncation") ||
          CONTAINS(?update_reasons, "DataOverwrite") ||
          CONTAINS(?update_reasons, "DataExtend")
        )
      }
    }
  }

  FILTER(?usn_events > 0)
}
ORDER BY ?domain
