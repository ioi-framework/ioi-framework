[
    {
        "@id": "kb:mft-source-file--{UUID}",
        "@type": "observable:File",
        "core:hasFacet": [
            {
                "@id": "kb:mft-source-facet--{UUID}",
                "@type": "observable:FileFacet",
                "observable:fileName": "{MFT_FILENAME}",
                "observable:filePath": "{MFT_FILEPATH}",
                "observable:extension": "{MFT_EXTENSION}",
                "observable:isDirectory": false,
                "observable:sizeInBytes": {
                    "@type": "xsd:integer",
                    "@value": "{MFT_SIZE}"
                }
            }
        ]
    }
]