{
  "@context": {
    "kb": "https://ioi-framework.github.io/kb/",
    "core": "https://ontology.unifiedcyberontology.org/uco/core/",
    "observable": "https://ontology.unifiedcyberontology.org/uco/observable/",
    "uco-action": "https://ontology.unifiedcyberontology.org/uco/action/",
    "ioi-ext": "https://ioi-framework.github.io/ns/ioi-ext/",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "kb:url--{URL_UUID}",
      "@type": "observable:URL",
      "core:hasFacet": [
        {
          "@id": "kb:url-facet--{URL_UUID}",
          "@type": "observable:URLFacet",
          "observable:fullValue": "{FULL_URL}"
        }
      ]
    },
    {
      "@id": "kb:url-history-entry--{ENTRY_UUID}",
      "@type": "observable:URLHistoryEntry",
      "core:hasFacet": [
        {
          "@id": "kb:url-history-facet--{ENTRY_UUID}",
          "@type": "observable:URLHistoryFacet",
          "observable:url": {
            "@id": "kb:url--{URL_UUID}"
          },
          "observable:pageTitle": "{TITLE}",
          "observable:visitCount": {
            "@type": "xsd:nonNegativeInteger",
            "@value": "{VISIT_COUNT}"
          },
          "observable:manuallyEnteredCount": {
            "@type": "xsd:nonNegativeInteger",
            "@value": "{TYPED_COUNT}"
          },
          "observable:lastVisit": {
            "@type": "xsd:dateTime",
            "@value": "{LAST_VISIT_DATETIME}"
          }
        }
      ]
    },
    {
      "@id": "kb:url-visit--{VISIT_UUID}",
      "@type": "observable:URLVisit",
      "core:hasFacet": [
        {
          "@id": "kb:url-visit-facet--{VISIT_UUID}",
          "@type": "observable:URLVisitFacet",
          "observable:url": {
            "@id": "kb:url--{URL_UUID}"
          },
          "observable:visitTime": {
            "@type": "xsd:dateTime",
            "@value": "{VISIT_DATETIME}"
          },
          "observable:visitDuration": {
            "@type": "xsd:duration",
            "@value": "PT{VISIT_DURATION_SECONDS}S"
          },
          "observable:urlTransitionType": "{TRANSITION}",
          "observable:fromURLVisit": {
            "@id": "kb:url-visit--{FROM_VISIT_UUID}"
          }
        }
      ]
    }
  ]
}
