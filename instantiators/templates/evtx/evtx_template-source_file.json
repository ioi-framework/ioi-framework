[
  {
    "@id": "kb:evtx-source-file--{SOURCE_UUID}",
    "@type": "observable:File",
    "uco-core:hasFacet": [
      {
        "@id": "kb:evtx-source-file-facet--{SOURCE_UUID}",
        "@type": "observable:FileFacet",
        "observable:fileName": "System",
        "observable:extension": ".evtx",
        "observable:filePath": "{SOURCE_FILE_PATH}",
        "observable:fileSystemType": "NTFS",
        "observable:sizeInBytes": {
          "@type": "xsd:integer",
          "@value": "{SOURCE_FILE_SIZE}"
        }
      }
    ]
  }
]
